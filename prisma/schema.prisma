generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}

model Workout {
  id          Int      @id @default(autoincrement())
  title       String
  duration    Int      // Duration in minutes
  description String 
  createdAt   DateTime @default(now())
}
