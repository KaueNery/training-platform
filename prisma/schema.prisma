generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int            @id @default(autoincrement())
  name         String
  email        String         @unique
  password     String
  age          Int
  country      String
  coachId      Int?
  coach        User?          @relation("UserToCoach", fields: [coachId], references: [id])
  athletes     User[]         @relation("UserToCoach")
  activities   Activity[]
  athletePlans TrainingPlan[] @relation("AthletePlans")
  coachPlans   TrainingPlan[] @relation("CoachPlans")
}

model Workout {
  id          Int      @id @default(autoincrement())
  title       String
  duration    Int // Duration in minutes
  description String
  createdAt   DateTime @default(now())
}

model Activity {
  id     String @id @default(uuid())
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  name           String?
  sportType      String
  startTime      DateTime
  distanceKm     Float
  durationSec    Int
  avgPace        String
  avgHr          Int?
  maxHr          Int?
  elevationGainM Float?
  elevationLossM Float?

  splits          Json?
  heartRateSeries Json?
  elevationSeries Json?

  trainingDayId Int? // 🔗 Link to planned day (optional)
  trainingDay   TrainingPlanDay? @relation(fields: [trainingDayId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingPlan {
  id      Int  @id @default(autoincrement())
  userId  Int // Athlete
  coachId Int? // Optional coach assignment

  user  User  @relation("AthletePlans", fields: [userId], references: [id])
  coach User? @relation("CoachPlans", fields: [coachId], references: [id])

  name      String
  goal      String?
  version   Int // 📌 Immutable versioning
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  createdAt    DateTime          @default(now())
  trainingDays TrainingPlanDay[]

  @@index([userId])
  @@index([coachId])
}

model TrainingPlanDay {
  id             Int          @id @default(autoincrement())
  trainingPlanId Int
  trainingPlan   TrainingPlan @relation(fields: [trainingPlanId], references: [id])

  date            DateTime // 🗓 Exact date
  title           String
  description     String?
  durationMinutes Int
  type            String // e.g., 'interval', 'long run', 'easy'

  createdBy           String // 'coach' | 'athlete'
  lastEditedBy        String // 'coach' | 'athlete'
  isModified          Boolean @default(false)
  isEditableByAthlete Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[] // Optional link to completed activities
}
